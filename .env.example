# Read-only PostgreSQL URL for the chat_memory schema.
# Use the provider's pooled connection string when one is supplied.
# Keep Preview and Production on separate databases or schemas and credentials.
# Tests must not target Production.
DATABASE_URL=
# Optional custom PostgreSQL CA. PEM, literal "\n" escapes, or base64 PEM.
# TLS stays strict. Never set rejectUnauthorized false.
AIVEN_PG_CA=
# Bearer token for get_chat_memory. Distinct from ingest and process tokens.
# Example generation: openssl rand -base64 32
CHAT_MEMORY_READ_TOKEN=
# Comma-separated Host allowlist. Hostnames or host:port. Ports are ignored.
# No wildcards. An empty list rejects every MCP request.
# Example: memory.example.com,memory-preview.example.com
CHAT_MEMORY_ALLOWED_HOSTS=
# Comma-separated browser Origin allowlist. Absolute http(s) origins, no paths.
# An unset or empty list rejects every present Origin and still allows an absent
# Origin for authenticated server-to-server callers.
# Example: https://operator.example.com
CHAT_MEMORY_ALLOWED_ORIGINS=
# Optional bounds. Defaults: pool 3, connect 300ms, lock 400ms, statement 1500ms,
# client query backstop 1700ms, idle 10000ms.
# statement + connection must stay <= 1900 so the bot's 2000ms lookup can finish.
CHAT_MEMORY_POOL_MAX=
CHAT_MEMORY_CONNECTION_TIMEOUT_MS=
CHAT_MEMORY_LOCK_TIMEOUT_MS=
CHAT_MEMORY_STATEMENT_TIMEOUT_MS=
CHAT_MEMORY_QUERY_TIMEOUT_MS=
CHAT_MEMORY_IDLE_TIMEOUT_MS=
